{
  "name": "@soffits/dsh-session-model",
  "version": "0.1.0",
  "description": "Keep a model picked in a DeepSeek Harness session in that session: the picker no longer rewrites the default model for new sessions.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "check": "for f in index.js test/*.js; do node --check \"$f\" || exit 1; done"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "keywords": ["dsh-plugin", "deepseek-harness", "dsh", "model", "default-model"],
  "author": "Sakina",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soffits/dsh-session-model.git"
  },
  "homepage": "https://github.com/soffits/dsh-session-model#readme",
  "bugs": {
    "url": "https://github.com/soffits/dsh-session-model/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
