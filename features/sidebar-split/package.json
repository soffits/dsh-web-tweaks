{
  "name": "dsh-sidebar-split",
  "version": "0.2.0",
  "description": "Resizable panes for the DeepSeek Harness sidebar: drag the line between the panel list and Workspaces, like VS Code's side bar.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "check": "for f in index.js client.js test/*.js; do node --check \"$f\" || exit 1; done"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "sidebar",
    "split",
    "resizable"
  ],
  "author": "Sakina",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soffits/dsh-sidebar-split.git"
  },
  "homepage": "https://github.com/soffits/dsh-sidebar-split#readme",
  "bugs": {
    "url": "https://github.com/soffits/dsh-sidebar-split/issues"
  }
}
